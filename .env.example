# ==========================================================================
# Plantilla de variables de entorno del to-do seguro.
# Copia este fichero a ".env" y rellena los valores. NUNCA subas .env al repo.
#   cp .env.example .env
#
# Genera un secreto fuerte (>=32 bytes) con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==========================================================================

# Entorno: development | production | test
NODE_ENV=production

# Puerto y host de escucha
PORT=3000
HOST=0.0.0.0

# Secreto de firma de las cookies de sesion (OBLIGATORIO en produccion, >=32 chars).
# >>> VALOR DE EJEMPLO: sustituyelo por uno generado de forma aleatoria <<<
SESSION_SECRET=CHANGE_ME_genera_un_secreto_aleatorio_de_al_menos_32_caracteres

# Tiempo de vida de la sesion en milisegundos (por defecto 30 min)
SESSION_MAX_AGE_MS=1800000

# Ruta del fichero SQLite (en contenedor se usa /app/data/todo.db)
DATABASE_PATH=/app/data/todo.db

# Coste de bcrypt (a mayor valor, mas seguro y mas lento). Recomendado: 12
BCRYPT_ROUNDS=12

# Activar a 1 si la app esta detras de un proxy/balanceador TLS (X-Forwarded-Proto)
TRUST_PROXY=0

# Nivel de log: trace | debug | info | warn | error
LOG_LEVEL=info

# Limitacion de tasa
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=300
